    "prohibited_visual_changes": {
      "items": {
        "type": "string"
      },
      "title": "Prohibited Visual Changes",
      "type": "array"
    },
    "prompt_aliases": {
      "items": {
        "type": "string"
      },
      "title": "Prompt Aliases",
      "type": "array"
    }
