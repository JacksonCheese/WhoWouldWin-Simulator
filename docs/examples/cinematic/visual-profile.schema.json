      "type": "array"
    },
    "distinctive_features": {
      "items": {
        "type": "string"
      },
      "title": "Distinctive Features",
      "type": "array"
    },
    "reference_image_paths": {
      "items": {
        "$ref": "#/$defs/AssetReference"
      },
