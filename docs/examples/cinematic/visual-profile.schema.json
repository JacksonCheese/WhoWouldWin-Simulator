        "asset_id": {
          "title": "Asset Id",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "role": {
          "default": "appearance_reference",
          "title": "Role",
          "type": "string"
        },
        "rights_note": {
          "default": "Development fixture; verify rights before production use.",
          "title": "Rights Note",
          "type": "string"
        }
      },
      "required": [
        "asset_id",
        "path"
      ],
      "title": "AssetReference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "character_id": {
      "title": "Character Id",
      "type": "string"
    },
    "version_id": {
      "title": "Version Id",
      "type": "string"
    },
    "development_fixture": {
      "default": true,
      "title": "Development Fixture",
      "type": "boolean"
    },
    "appearance_description": {
      "title": "Appearance Description",
      "type": "string"
    },
    "body_description": {
      "title": "Body Description",
      "type": "string"
    },
    "face_description": {
      "title": "Face Description",
      "type": "string"
    },
    "hair_description": {
      "title": "Hair Description",
      "type": "string"
    },
    "costume_description": {
      "title": "Costume Description",
      "type": "string"
    },
    "color_palette": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
